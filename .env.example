# Chat Widget API Endpoint
# Development: point to local backend
# Production: point to deployed API
VITE_API_URL=http://localhost:3001/api/chat

# Comma-separated browser origins allowed to call the API.
# Add the exact Cloudflare Pages production URL on Render.
ALLOWED_ORIGINS=http://localhost:5173

# Chat API rate limit (POST /api/chat only). Set RATE_LIMIT_MAX=0 to disable (local eval).
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=3600000
